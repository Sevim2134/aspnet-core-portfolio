@using EntityLayer.Concrete
@model List<SocialMedia>
@if (Model.Count > 0)
{
    <nav aria-label="Sosyal medya">
        <ul class="social-links">
            @foreach (var item in Model)
            {
                // Font ikon sınıfları yerine bağlantının okunur adı kullanılır.
                var label = string.IsNullOrWhiteSpace(item.Name) ? "Sosyal bağlantı" : item.Name;
                <li><a href="@item.Url" title="@label" target="_blank" rel="noopener noreferrer">@label <span aria-hidden="true">↗</span></a></li>
            }
        </ul>
    </nav>
}