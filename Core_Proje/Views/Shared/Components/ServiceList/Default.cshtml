@using EntityLayer.Concrete
@model List<Service>
<section id="services" class="portfolio-section section-tinted" aria-labelledby="services-title">
    <div class="container">
        <div class="section-heading"><p class="eyebrow">NELER YAPIYORUM?</p><h2 id="services-title">Hizmetlerim<span class="accent-text">.</span></h2></div>
        <div class="row g-4">
            @for (var index = 0; index < Model.Count; index++)
            {
                var item = Model[index];
                <div class="col-12 col-md-6">
                    <article class="portfolio-card service-card h-100">
                        <div class="service-top">
                            <span class="service-number">@((index + 1).ToString("00"))</span>
                            @await Html.PartialAsync("~/Views/Default/_PortfolioImage.cshtml", item.ImageUrl ?? string.Empty)
                        </div>
                        <h3>@item.Title</h3>
                        <span class="service-rule" aria-hidden="true"></span>
                    </article>
                </div>
            }
        </div>
        @if (Model.Count == 0) { <p class="empty-state">Hizmetler henüz eklenmedi.</p> }
    </div>
</section>