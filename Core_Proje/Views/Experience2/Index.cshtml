    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using EntityLayer.Concrete
@model List<Experience>

@{
	Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}
<div class="col-md-6">
	<div class="p-2">
		<button type="button" id="btngetlistall" class="btn btn-outline-primary">Verileri Getir</button>
		<button type="button" id="btnadd" class="btn btn-outline-info">Kaydet</button>
		<button type="button" id="btnid" class="btn btn-outline-warning">Id ile Getir</button>
		<button type="button" id="btndelete" class="btn btn-outline-danger">Sil</button>
		<button type="button" id="btnupdate" class="btn btn-outline-success">Güncelle</button>
	</div>
</div>


<div class="p-2" id="listexperience">

</div>
<br />

<div class="p-2" id="listbyidexperience">

</div>
<br />



<div class="col-md-12">
	<h5>Ekleme Paneli</h5>
	<input type="text" class="form-control" id="inpname" placeholder="Başlık" />
	<br />
	<input type="text" class="form-control" id="inpdate" placeholder="Tarih" />
	<br />
	<input type="text" class="form-control" id="inpdescription" placeholder="Açıklama" />

</div>
<br />
<br />

<div class="col-md-12">
	<h5>Id'ye Göre Getirme Paneli</h5>
	<input type="text" class="form-control" id="inpid" placeholder="ID Giriniz" />

</div>
<br />
<br />

<div class="col-md-12">
	<h5>Silme Paneli</h5>
	<input type="text" class="form-control" id="inpexpid" placeholder="ID Giriniz" />

</div>

<br />
<br />

<div class="col-md-12">
	<h5>Güncelleme Paneli</h5>
	<input type="text" class="form-control" id="inpupdateid" placeholder="Deneyim ID" />
	<input type="text" class="form-control" id="inpupdatename" placeholder="Başlık" />
	<input type="text" class="form-control" id="inpupdatedate" placeholder="Tarih" />
	<input type="text" class="form-control" id="inpupdatedescription" placeholder="Açıklama" />

</div>
<br />








@section Scripts
{
	<script>
		$("#btngetlistall").click(function() {
			$.ajax({
				contentType: "application/json",
				dataType: "json",
				type: "Get",
				url: "/Experience2/ListExperience/",

				success: function(funk) {
					let values = jQuery.parseJSON(funk);
					console.log(values);

					let htmlst = "<table class='table table-bordered'><tr><th>ID</th><th>Başlık</th><th>Tarih</th></tr>";

					$.each(values, (index, value) => {
						htmlst += `<tr><td>${value.ExperienceID}</td><td>${value.Name}</td><td>${value.Date}</td></tr>`;
					});

					htmlst += "</table>";
					$("#listexperience").html(htmlst);
				}

			});
		});


		$("#btnadd").click(function() {
			let values = {
				Name: $("#inpname").val(),
				Date: $("#inpdate").val(),
				Description: $("#inpdescription").val()
			};

			$.ajax({
				type: "Post",
				url: "/Experience2/AddExperience/",
				data: values,
				success: function(funk1) {
					let result = jQuery.parseJSON(funk1);
					alert(result.Name + "Başarılı bir şekilde eklendi.");
				}

			});
		});

		$("#btnid").click(x => {
			let id = $("#inpid").val();

			$.ajax({
				contentType:"application/json",
				dataType:"json",
				type:"Get",
				url:"/Experience2/GetById/",
				data: { ExperienceID:id},
				success:function(funk2){
					let result=jQuery.parseJSON(funk2);
					console.log(result);
					let htmlstr=`<table class='table table-hover'><tr><th>Deneyim Id</th><td>${result.ExperienceID}</td></tr>
					             <tr><th>Deneyim Başlığı</th><td>${result.Name}</td></tr></table>`;
					$("#listbyidexperience").html(htmlstr);

					$("#inpupdateid").val(result.ExperienceID);
					$("#inpupdatename").val(result.Name);
					$("#inpupdatedate").val(result.Date);
					$("#inpupdatedescription").val(result.Description);
				}
			});
		});

		$("#btndelete").click(x=>{
			let id=$("#inpexpid").val();
			$.ajax({
				url:"/Experience2/DeleteExperience/"+id,
				type:"post",
				contentType:"application/json",
				dataType:"json",
				success:function(funk3){
					// loadData();
					alert("Silme işlemi başarılı.");
					$("#btngetlistall").click();
				},
				error: function(xhr) {
					alert("Silme başarısız: " + xhr.responseText);
				}

			});
		});

		$("#btnupdate").click(function(){
			let values={
				ExperienceID: $("#inpupdateid").val(),
				Name: $("#inpupdatename").val(),
				Date: $("#inpupdatedate").val(),
				Description: $("#inpupdatedescription").val()
			};

			$.ajax({
				type:"post",
				url:"/Experience2/UpdateExperience/",
				data:values,
				success:function(funk4){
				 let result=jQuery.parseJSON(funk4);
				 alert(result.Name+"Başarılı bir şekilde güncellendi.");
				}

			});
		});


	</script>
}


<script src="~/lib/jquery/dist/jquery.js"></script>
