@using EntityLayer.Concrete
@model List<Service>

@{
	Layout = "~/Views/Shared/_NewAdminLayout.cshtml";
}


<div class="card-header border-0">
	<h3 class="mb-0">Hizmet Listesi Tablosu</h3>
</div>

<div class="table-responsive">
	<table class="table align-items-center table-flush">
		<thead class="thead-light">
			<tr>
				<th scope="col" class="sort" data-sort="name">#</th>
				<th scope="col" class="sort" data-sort="budget">Başlık</th>
				<th scope="col">Sil</th>
				<th scope="col" class="sort" data-sort="completion">Düzenle</th>
				<
			</tr>
		</thead>
		<tbody class="list">
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.ServiceID</td>

					<td class="budget">
						@item.Title
					</td>

					
					<td><a href="/Service/DeleteService/@item.ServiceID" class="btn btn-outline-danger">Sil</a></td>
					<td><a href="/Service/EditService/@item.ServiceID" class="btn btn-outline-info">Güncelle</a></td>

				</tr>
			}
		</tbody>
	</table>
	<br />
	<a href="/Service/AddService/" class="btn btn-primary">Yeni Hizmet Ekle</a>
	<br />
</div>
	

          
