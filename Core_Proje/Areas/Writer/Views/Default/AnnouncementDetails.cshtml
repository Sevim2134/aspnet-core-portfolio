@model EntityLayer.Concrete.Announcement

@{
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}
<h3 class="mb-3">Duyuru Detayları</h3>

<div class="container">
    <form class="form-group">
        <div class="mb-5">
            @Html.Label("ID","ID", new { @class = "fw-bold" })
            @Html.TextBoxFor(x => x.ID, new { @class = "form-control" })
        </div>
        <br />
        <div class="mb-5">
            @Html.Label("Content","İçerik", new { @class = "fw-bold" })
            @Html.TextAreaFor(x => x.Content, 10, 3, new { @class = "form-control" })
        </div>

    </form>

</div>